# ============================================================
# Clean Center - configuración de ejemplo
# Copiar a .env y reemplazar TODOS los valores antes de producción.
# ============================================================

ENVIRONMENT=development
APP_NAME=Clean Center API

# Seguridad
# Generar con: openssl rand -hex 32
JWT_SECRET_KEY=replace-this-with-openssl-rand-hex-32-000000000000
ACCESS_TOKEN_EXPIRE_MINUTES=120
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Base de datos
# En Docker se sobreescribe a sqlite:////app/data/clean_center.db
DATABASE_URL=sqlite:///./data/clean_center.db

# CORS (separar por comas)
CORS_ORIGINS=http://localhost:4200

# Rate limiting
RATE_LIMIT_ENABLED=true
RESERVATION_RATE_LIMIT=5/minute
LOOKUP_RATE_LIMIT=10/minute
LOGIN_RATE_LIMIT=5/minute

# Datos comerciales públicos
STORE_NAME="Clean Center"
STORE_LEGAL_NAME="Clean Center"
STORE_CUIT=30-12345678-9
STORE_ADDRESS="Almirante Brown 4910"
STORE_PHONE="5491128159859"
STORE_EMAIL=Karentorresbarreiro@gmail.com
STORE_HOURS="09:30 a 13:00 y de 17:00 a 20:00"

# Parámetros de reserva
RESERVATION_EXPIRATION_HOURS=48
MIN_PICKUP_LEAD_MINUTES=60

# Parámetros legales
AAIP_URL=https://www.argentina.gob.ar/aaip
TERMS_VERSION=2026-11
PRIVACY_VERSION=2026-11

# WhatsApp: código de país + área + número, sin +, espacios ni guiones.
# Ejemplo Argentina: 5491123456789
WHATSAPP_PHONE="5491128159859"

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
LOG_FILE=
